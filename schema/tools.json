{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MohoMCP Tool Definitions",
  "description": "JSON Schema definitions for all MohoMCP tools (Phase 1 MVP)",
  "version": "0.1.0",
  "tools": {
    "document.getInfo": {
      "description": "Get information about the currently open MOHO document",
      "params": {},
      "result": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "filePath": { "type": "string" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "fps": { "type": "number" },
          "startFrame": { "type": "number" },
          "endFrame": { "type": "number" },
          "currentFrame": { "type": "number" }
        }
      }
    },
    "document.getLayers": {
      "description": "Get a hierarchical list of all layers in the document",
      "params": {},
      "result": {
        "type": "object",
        "properties": {
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "number" },
                "name": { "type": "string" },
                "type": { "type": "string" },
                "visible": { "type": "boolean" },
                "locked": { "type": "boolean" },
                "parentId": { "type": ["number", "null"] },
                "children": { "type": "array" }
              }
            }
          }
        }
      }
    },
    "layer.getProperties": {
      "description": "Get detailed properties of a specific layer",
      "params": {
        "type": "object",
        "required": ["layerId"],
        "properties": {
          "layerId": { "type": "number", "description": "Absolute layer ID" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "visible": { "type": "boolean" },
          "locked": { "type": "boolean" },
          "opacity": { "type": "number" },
          "blendMode": { "type": "string" },
          "transform": { "type": "object" }
        }
      }
    },
    "layer.getChildren": {
      "description": "Get child layers of a group layer",
      "params": {
        "type": "object",
        "required": ["layerId"],
        "properties": {
          "layerId": { "type": "number", "description": "Absolute layer ID of the group" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "layerId": { "type": "number" },
          "children": { "type": "array" }
        }
      }
    },
    "layer.getBones": {
      "description": "Get all bones in a bone layer",
      "params": {
        "type": "object",
        "required": ["layerId"],
        "properties": {
          "layerId": { "type": "number", "description": "Absolute layer ID of the bone layer" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "layerId": { "type": "number" },
          "boneCount": { "type": "number" },
          "bones": { "type": "array" }
        }
      }
    },
    "bone.getProperties": {
      "description": "Get detailed properties of a specific bone",
      "params": {
        "type": "object",
        "required": ["layerId", "boneId"],
        "properties": {
          "layerId": { "type": "number", "description": "Absolute layer ID of the bone layer" },
          "boneId": { "type": "number", "description": "Bone index within the layer" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "name": { "type": "string" },
          "position": { "type": "object" },
          "angle": { "type": "number" },
          "scale": { "type": "number" },
          "length": { "type": "number" },
          "parentId": { "type": "number" },
          "constraints": { "type": "object" }
        }
      }
    },
    "animation.getKeyframes": {
      "description": "Get keyframe data for a specific animation channel on a layer",
      "params": {
        "type": "object",
        "required": ["layerId", "channel"],
        "properties": {
          "layerId": { "type": "number", "description": "Absolute layer ID" },
          "channel": { "type": "string", "description": "Channel name: translation, rotation, scale, opacity, shear" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "layerId": { "type": "number" },
          "channel": { "type": "string" },
          "keyCount": { "type": "number" },
          "keyframes": { "type": "array" }
        }
      }
    },
    "animation.getFrameState": {
      "description": "Get the full animation state of a layer at a specific frame",
      "params": {
        "type": "object",
        "required": ["layerId", "frame"],
        "properties": {
          "layerId": { "type": "number", "description": "Absolute layer ID" },
          "frame": { "type": "number", "description": "Frame number to query" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "layerId": { "type": "number" },
          "frame": { "type": "number" },
          "translation": { "type": "object" },
          "rotation": { "type": "number" },
          "scale": { "type": "object" },
          "opacity": { "type": "number" },
          "visible": { "type": "boolean" }
        }
      }
    },
    "mesh.getPoints": {
      "description": "Get all mesh points (vertices) in a vector layer",
      "params": {
        "type": "object",
        "required": ["layerId"],
        "properties": {
          "layerId": { "type": "number", "description": "Absolute layer ID of the vector layer" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "layerId": { "type": "number" },
          "pointCount": { "type": "number" },
          "points": { "type": "array" }
        }
      }
    },
    "mesh.getShapes": {
      "description": "Get all shapes (filled regions) in a vector layer",
      "params": {
        "type": "object",
        "required": ["layerId"],
        "properties": {
          "layerId": { "type": "number", "description": "Absolute layer ID of the vector layer" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "layerId": { "type": "number" },
          "shapeCount": { "type": "number" },
          "shapes": { "type": "array" }
        }
      }
    },
    "layer.createLayer": {
      "description": "Create a new layer in the MOHO document",
      "params": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["vector", "group", "bone", "image", "switch", "particle", "note", "patch", "audio"]
          },
          "name": { "type": "string" },
          "parentId": { "type": "number" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "layerId": { "type": "number" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "parentId": { "type": "number" }
        }
      }
    },
    "layer.deleteLayer": {
      "description": "Delete a layer from the document",
      "params": {
        "type": "object",
        "required": ["layerId"],
        "properties": {
          "layerId": { "type": "number" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "layerId": { "type": "number" }
        }
      }
    },
    "bone.addBone": {
      "description": "Add a new bone to a bone layer's skeleton",
      "params": {
        "type": "object",
        "required": ["layerId"],
        "properties": {
          "layerId": { "type": "number" },
          "name": { "type": "string" },
          "posX": { "type": "number" },
          "posY": { "type": "number" },
          "angle": { "type": "number" },
          "length": { "type": "number" },
          "scale": { "type": "number" },
          "parentBoneId": { "type": "number" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "layerId": { "type": "number" },
          "boneId": { "type": "number" },
          "name": { "type": "string" }
        }
      }
    },
    "bone.deleteBone": {
      "description": "Delete a bone from a skeleton; recursive=true also deletes children",
      "params": {
        "type": "object",
        "required": ["layerId", "boneId"],
        "properties": {
          "layerId": { "type": "number" },
          "boneId": { "type": "number" },
          "recursive": { "type": "boolean" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "recursive": { "type": "boolean" }
        }
      }
    },
    "bone.setRestPose": {
      "description": "Set the rest-pose properties of a bone",
      "params": {
        "type": "object",
        "required": ["layerId", "boneId"],
        "properties": {
          "layerId": { "type": "number" },
          "boneId": { "type": "number" },
          "name": { "type": "string" },
          "posX": { "type": "number" },
          "posY": { "type": "number" },
          "angle": { "type": "number" },
          "length": { "type": "number" },
          "scale": { "type": "number" },
          "parentBoneId": { "type": "number" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "changed": { "type": "object" }
        }
      }
    },
    "mesh.addPoint": {
      "description": "Add a new mesh point to a vector layer (lone, appended, or attached to an existing point)",
      "params": {
        "type": "object",
        "required": ["layerId", "x", "y"],
        "properties": {
          "layerId": { "type": "number" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "frame": { "type": "number" },
          "connectToPointId": { "type": "number" },
          "startNewCurve": { "type": "boolean" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "pointIndex": { "type": "number" },
          "pointCount": { "type": "number" },
          "position": { "type": "object" },
          "mode": { "type": "string", "enum": ["lone", "append", "attach"] }
        }
      }
    },
    "mesh.createShape": {
      "description": "Create a new shape from a list of mesh point indices via moho:CreateShape",
      "params": {
        "type": "object",
        "required": ["layerId", "pointIndices"],
        "properties": {
          "layerId": { "type": "number" },
          "pointIndices": { "type": "array", "items": { "type": "number" }, "minItems": 2 },
          "filled": { "type": "boolean", "description": "Whether the shape is filled (default true)" },
          "frame": { "type": "number" },
          "name": { "type": "string" },
          "fillColor": { "type": "string" },
          "strokeColor": { "type": "string" },
          "strokeWidth": { "type": "number" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "shapeIndex": { "type": "number" },
          "shapeCount": { "type": "number" }
        }
      }
    },
    "document.save": {
      "description": "Save the current MOHO document",
      "params": {
        "type": "object",
        "properties": {
          "filePath": { "type": "string", "description": "Optional. When supplied, performs Save As." }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "filePath": { "type": "string" }
        }
      }
    },
    "mesh.setPointCurvature": {
      "description": "Set the curvature passing through a single mesh point",
      "params": {
        "type": "object",
        "required": ["layerId", "pointIndex", "curvature"],
        "properties": {
          "layerId": { "type": "number" },
          "pointIndex": { "type": "number" },
          "curvature": { "type": "number" },
          "frame": { "type": "number" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "curvature": { "type": "number" }
        }
      }
    },
    "mesh.getCurves": {
      "description": "List all curves with their mesh-global point indices",
      "params": {
        "type": "object",
        "required": ["layerId"],
        "properties": { "layerId": { "type": "number" } }
      },
      "result": {
        "type": "object",
        "properties": {
          "curveCount": { "type": "number" },
          "curves": { "type": "array" }
        }
      }
    },
    "mesh.setBezierHandle": {
      "description": "Set one bezier control handle on a curve point",
      "params": {
        "type": "object",
        "required": ["layerId", "curveIndex", "curvePointIndex", "x", "y"],
        "properties": {
          "layerId": { "type": "number" },
          "curveIndex": { "type": "number" },
          "curvePointIndex": { "type": "number" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "frame": { "type": "number" },
          "prePoint": { "type": "boolean" },
          "syncAngles": { "type": "boolean" }
        }
      },
      "result": { "type": "object", "properties": { "success": { "type": "boolean" } } }
    },
    "mesh.bindPoints": {
      "description": "Bind mesh points to a bone (boneId: -1 unbind, -2 flexi, else bone index)",
      "params": {
        "type": "object",
        "required": ["layerId", "pointIndices", "boneId"],
        "properties": {
          "layerId": { "type": "number" },
          "pointIndices": { "type": "array", "items": { "type": "number" }, "minItems": 1 },
          "boneId": { "type": "number" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "pointsBound": { "type": "array" }
        }
      }
    },
    "layer.setParentBone": {
      "description": "Set the controlling parent bone for a layer (-1 to clear)",
      "params": {
        "type": "object",
        "required": ["layerId", "boneId"],
        "properties": {
          "layerId": { "type": "number" },
          "boneId": { "type": "number" }
        }
      },
      "result": { "type": "object", "properties": { "success": { "type": "boolean" } } }
    },
    "layer.placeInGroup": {
      "description": "Move a layer into a group",
      "params": {
        "type": "object",
        "required": ["layerId", "parentGroupId"],
        "properties": {
          "layerId": { "type": "number" },
          "parentGroupId": { "type": "number" },
          "top": { "type": "boolean" }
        }
      },
      "result": { "type": "object", "properties": { "success": { "type": "boolean" } } }
    },
    "layer.placeBehind": {
      "description": "Reorder a layer behind another in its group",
      "params": {
        "type": "object",
        "required": ["layerId", "behindLayerId"],
        "properties": {
          "layerId": { "type": "number" },
          "behindLayerId": { "type": "number" }
        }
      },
      "result": { "type": "object", "properties": { "success": { "type": "boolean" } } }
    },
    "layer.activateAction": {
      "description": "Activate an action for editing (or empty string for mainline)",
      "params": {
        "type": "object",
        "required": ["layerId"],
        "properties": {
          "layerId": { "type": "number" },
          "actionName": { "type": "string" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "currentAction": { "type": "string" }
        }
      }
    },
    "layer.listActions": {
      "description": "List actions on a layer, including which are smart-bone dials",
      "params": {
        "type": "object",
        "required": ["layerId"],
        "properties": { "layerId": { "type": "number" } }
      },
      "result": {
        "type": "object",
        "properties": {
          "actionCount": { "type": "number" },
          "currentAction": { "type": "string" },
          "actions": { "type": "array" }
        }
      }
    },
    "bone.createSmartAction": {
      "description": "Create a smart-bone action named after the given bone",
      "params": {
        "type": "object",
        "required": ["layerId", "boneId"],
        "properties": {
          "layerId": { "type": "number" },
          "boneId": { "type": "number" },
          "frame": { "type": "number" }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "actionName": { "type": "string" },
          "created": { "type": "boolean" },
          "isSmartBone": { "type": "boolean" }
        }
      }
    }
  }
}
